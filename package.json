{
  "name": "bankheist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:smoke": "playwright test --grep @smoke",
    "test:visual": "playwright test --grep @visual --fully-parallel",
    "test:visual:update": "playwright test --grep @visual --fully-parallel --update-snapshots",
    "sweep": "vitest run --config scripts/vitest.sweep.config.ts",
    "screenshot": "playwright test -g \"boots into the game\""
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
